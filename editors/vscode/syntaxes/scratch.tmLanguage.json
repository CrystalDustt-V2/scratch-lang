{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "scratch-lang",
  "scopeName": "source.scratch",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#events" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#extensions" },
    { "include": "#subsystems" },
    { "include": "#builtins" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.scratch",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.scratch",
          "match": "\\b(when|if|else|repeat|while|fn|return|every|after|seconds|touches)\\b"
        },
        {
          "name": "keyword.operator.logical.scratch",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.boolean.scratch",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "events": {
      "patterns": [
        {
          "name": "entity.name.function.event.scratch",
          "match": "\\b(start|update|click|clone|scene\\.switched|action\\.(down|press|up)|message)\\b"
        }
      ]
    },
    "extensions": {
      "patterns": [
        {
          "name": "support.function.pen.scratch",
          "match": "\\bpen\\.(clear|stamp|down|up|set_color|change_param|set_param|change_size|set_size)\\b"
        },
        {
          "name": "support.function.music.scratch",
          "match": "\\bmusic\\.(play_drum|rest|play_note|set_instrument|set_tempo|change_tempo|get_tempo)\\b"
        },
        {
          "name": "support.function.tts.scratch",
          "match": "\\btts\\.(speak|set_voice|set_language)\\b"
        },
        {
          "name": "support.function.translate.scratch",
          "match": "\\btranslate\\.(text|get_language)\\b"
        },
        {
          "name": "support.function.makey.scratch",
          "match": "\\bmakey\\.(key|code)\\b"
        }
      ]
    },
    "subsystems": {
      "patterns": [
        {
          "name": "support.function.sound.scratch",
          "match": "\\bsound\\.(play|play_until_done|stop_all|change_effect|set_effect|clear_effects|change_volume|set_volume|get_volume)\\b"
        },
        {
          "name": "support.function.list.scratch",
          "match": "\\blist\\.(to_string|add|delete|clear|insert|replace|item|index_of|length|contains|show|hide)\\b"
        },
        {
          "name": "support.function.text.scratch",
          "match": "\\btext\\.(join|letter_at|length|contains)\\b"
        },
        {
          "name": "support.function.math.scratch",
          "match": "\\bmath\\.(mod|round|abs|sqrt|sin|cos|tan|asin|acos|atan|ln|log|exp|pow10)\\b"
        },
        {
          "name": "support.function.variable.scratch",
          "match": "\\bvariable\\.(show|hide)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.motion.scratch",
          "match": "\\b(move|turn_right|turn_left|go_to|teleport|glide|glide_to|point_in_direction|point_towards|change_x|set_x|change_y|set_y|bounce_on_edge|set_rotation_style|x_position|y_position|get_direction)\\b"
        },
        {
          "name": "support.function.builtin.looks.scratch",
          "match": "\\b(say|say_for|think|think_for|switch_costume|next_costume|switch_backdrop|switch_backdrop_and_wait|next_backdrop|change_size|set_size|change_effect|set_effect|clear_effects|show|hide|go_to_front|go_to_back|go_forward_layers|go_back_layers|get_costume_number|get_costume_name|get_backdrop_number|get_backdrop_name|get_size)\\b"
        },
        {
          "name": "support.function.builtin.sensing.scratch",
          "match": "\\b(touching|touching_color|color_touching_color|distance_to|ask|get_answer|key_pressed|mouse_down|mouse_x|mouse_y|set_drag_mode|get_loudness|loudness|get_timer|reset_timer|property_of|current|days_since_2000|get_username)\\b"
        },
        {
          "name": "support.function.builtin.control.scratch",
          "match": "\\b(wait|wait_until|stop_all|clone|delete_clone)\\b"
        },
        {
          "name": "support.function.builtin.operators.scratch",
          "match": "\\brandom\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.scratch",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.scratch",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.scratch",
          "match": "\\b-?[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.scratch",
          "match": "(\\+|-|\\*|/|%|==|!=|<=|>=|<|>|=|\\+=|-=)"
        }
      ]
    }
  }
}
