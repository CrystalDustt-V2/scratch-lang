{
  "name": "scratch-lang",
  "displayName": "Scratch Language Support",
  "icon": "./resources/cat-as-scratch.png",
  "description": "Complete language support, real-time linting, formatting, IntelliSense completions, and LSP for scratch-lang (.sch)",
  "version": "1.0.0",
  "publisher": "CrystalDust",
  "repository": {
    "type": "git",
    "url": "https://github.com/CrystalDustt-V2/scratch-lang.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Snippets"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:scratch"
  ],
  "contributes": {
    "languages": [
      {
        "id": "scratch",
        "aliases": [
          "scratch-lang",
          "scratch",
          "Scratch"
        ],
        "extensions": [
          ".sch"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./resources/cat-as-scratch.png",
          "dark": "./resources/cat-as-scratch.png"
        }
      },
      {
        "id": "scratch-project",
        "aliases": [
          "Scratch Project",
          "schproj"
        ],
        "extensions": [
          ".schproj"
        ],
        "icon": {
          "light": "./resources/schproj.png",
          "dark": "./resources/schproj.png"
        }
      },
      {
        "id": "scratch-scene",
        "aliases": [
          "Scratch Scene",
          "schscene",
          "scene"
        ],
        "extensions": [
          ".schscene",
          ".scene"
        ],
        "icon": {
          "light": "./resources/schscene.png",
          "dark": "./resources/schscene.png"
        }
      }
    ],
    "iconThemes": [
      {
        "id": "scratch-icon-theme",
        "label": "Scratch Language Icons",
        "path": "./icons/scratch-icon-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "scratch",
        "scopeName": "source.scratch",
        "path": "./syntaxes/scratch.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "scratch",
        "path": "./snippets/scratch.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "scratch.run",
        "title": "Scratch: Run Project (GUI Preview)",
        "icon": "$(play)"
      },
      {
        "command": "scratch.check",
        "title": "Scratch: Check & Lint Project",
        "icon": "$(check)"
      },
      {
        "command": "scratch.studio",
        "title": "Scratch: Open Visual Project Studio",
        "icon": "$(layout)"
      },
      {
        "command": "scratch.restartServer",
        "title": "Scratch: Restart Language Server",
        "icon": "$(refresh)"
      },
      {
        "command": "scratch.searchFunctions",
        "title": "Scratch: Search Functions & Blocks",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "scratch.searchFunctions",
          "when": "resourceExtname == .sch",
          "group": "navigation"
        },
        {
          "command": "scratch.run",
          "when": "resourceExtname == .sch",
          "group": "navigation"
        },
        {
          "command": "scratch.check",
          "when": "resourceExtname == .sch",
          "group": "navigation"
        },
        {
          "command": "scratch.studio",
          "when": "resourceExtname == .sch",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "scratch.searchFunctions",
          "when": "editorLangId == scratch",
          "group": "1_modification"
        }
      ]
    },
    "keybindings": [
      {
        "command": "scratch.searchFunctions",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus"
      }
    ],
    "configurationDefaults": {
      "[scratch]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        },
        "editor.suggestOnTriggerCharacters": true,
        "editor.wordBasedSuggestions": "matchingDocuments",
        "editor.suggest.showIcons": true,
        "editor.suggest.showStatusBar": true,
        "editor.suggest.preview": true,
        "editor.acceptSuggestionOnEnter": "on",
        "editor.tabCompletion": "on"
      }
    },
    "configuration": {
      "type": "object",
      "title": "scratch-lang Configuration",
      "properties": {
        "scratch.lsp.path": {
          "type": "string",
          "default": "scratch",
          "description": "Path or command name for the scratch CLI executable"
        },
        "scratch.lsp.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable Language Server Protocol features (linting, autocompletion, hover, formatting)"
        },
        "scratch.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic document formatting with scratch-lang standard rules"
        },
        "scratch.lint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time diagnostic reporting (syntax errors, missing assets, typo suggestions)"
        }
      }
    }
  }
}
